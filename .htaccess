Options -Indexes

# The app serves raw media, backup archives and Range/206 responses. Webserver
# compression (mod_deflate / mod_brotli / mod_gzip) strips Content-Length and
# corrupts streamed downloads: on hosts that enable it (e.g. DirectAdmin
# shared hosting) video previews break and downloads show no file size.
# Disable it app-wide, keeping compression only for the admin SPA page.
<IfModule mod_setenvif.c>
SetEnv no-gzip
SetEnv no-brotli
SetEnvIf Request_URI "^(/admin/?|/admin/index\.php)$" !no-gzip
SetEnvIf Request_URI "^(/admin/?|/admin/index\.php)$" !no-brotli
</IfModule>
<IfModule mod_deflate.c>
SetEnv no-gzip
SetEnvIf Request_URI "^(/admin/?|/admin/index\.php)$" !no-gzip
</IfModule>
<IfModule mod_brotli.c>
SetEnv no-brotli
SetEnvIf Request_URI "^(/admin/?|/admin/index\.php)$" !no-brotli
</IfModule>
<IfModule mod_gzip.c>
mod_gzip_on No
</IfModule>

# Belt and braces for mod_php / LiteSpeed SAPIs: the app also disables PHP
# output compression at runtime, this covers cases where that is ineffective.
# If your host rejects php_value in .htaccess (500 on every page), remove the
# matching <IfModule> block below - the rules above are the important part.
<IfModule mod_php.c>
php_value zlib.output_compression Off
</IfModule>
<IfModule mod_php7.c>
php_value zlib.output_compression Off
</IfModule>
<IfModule mod_php8.c>
php_value zlib.output_compression Off
</IfModule>
<IfModule mod_lsapi.c>
php_value zlib.output_compression Off
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On

# Block direct access to internal directories and configuration
RewriteRule ^(data|lib|tests|tools)(/|$) - [F,L]
RewriteRule ^\.git(/|$) - [F,L]
RewriteRule ^config\.php$ - [F,L]

# Serve the app's own PHP files directly (the pattern excludes the query
# string, so api.php?action=... keeps working)
RewriteRule ^(index|install)\.php$ - [L]
RewriteRule ^admin/(index|api)\.php$ - [L]

# Admin area (single page app)
RewriteRule ^admin/?$ admin/index.php [L,QSA]
RewriteRule ^admin/ admin/index.php [L,QSA]

# S3 API: everything else goes to the front controller
RewriteRule ^ index.php [L,QSA]
</IfModule>
